---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';

const metadata = {
  title: 'About us',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About VNDEVS"
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'VNDEVS Team Image',
    }}
  >
    <Fragment slot="title">
      Empowering businesses with <br />
      <span class="text-accent dark:text-white">software, games, and digital solutions</span>
    </Fragment>

    <Fragment slot="subtitle">
      VNDEVS is a small, agile team dedicated to delivering software development, consulting, UI/UX analysis, and hosted
      game solutions. We combine creativity, technical excellence, and a customer-first mindset to help your project
      succeed.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Quick Facts"
    stats={[
      { title: 'Cities', amount: '2' },
      { title: 'Projects Completed', amount: '12+' },
      { title: 'Ongoing Projects', amount: '5+' },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Our Services"
    subtitle="We provide flexible solutions tailored to your business needs."
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'Software Development',
        description:
          'Web apps, mobile apps, and custom software built with best practices, high performance, and maintainability.',
        icon: 'tabler:code',
      },
      {
        title: 'UI/UX Design & Analysis',
        description: 'User-centered design solutions with usability analysis to maximize engagement and conversion.',
        icon: 'tabler:layout',
      },
      {
        title: 'Consulting & Outsourcing',
        description: 'Expert advice and outsourced development support to help your project scale efficiently.',
        icon: 'tabler:users',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Our Values"
    subtitle="How we approach every project"
    items={[
      {
        title: 'Customer-Focused',
        description: 'We put your goals first, ensuring solutions meet your unique business needs.',
      },
      {
        title: 'Agile & Efficient',
        description: 'Small team, fast delivery, clear communication, and flexible adaptation to changes.',
      },
      {
        title: 'Integrity & Quality',
        description: 'We uphold high standards, delivering reliable solutions you can trust.',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->
  <Testimonials
    title="Core Members"
    testimonials={[
      {
        testimonial: `Versatile Front-end Developer with 9 years of experience designing, developing, and managing complex sites, apps and internal frameworks. Specializes in Reactjs and responsive design.`,
        name: 'Khanh Nguyen',
        job: 'Senior Software Engineer',
        image: {
          src: '',
          alt: 'Khanh Nguyen Image',
        },
      },
      {
        testimonial: `Extensive experience in Design, Development, & Application Maintainance|Adept at Product Development, Technical Experimentation, Functional Design Specifications, & Cloud Computing`,
        name: 'Long Dinh',
        job: 'Senior Software Engineer',
        image: {
          src: 'https://images.unsplash.com/photo-1561406636-b80293969660?auto=format&fit=crop&w=774&q=80',
          alt: 'Long Dinh Image',
        },
      },
      {
        testimonial: `Specialized in DevOps, Cloud Systems, & Site Reliability | Experienced in CI/CD Pipelines, Automated Deployment, Functional Design, & Scalable Applications`,
        name: 'Quang Tran',
        job: 'Senior Software Engineer',
        image: {
          src: '',
          alt: 'Quang Tran Image',
        },
      },
    ]}
    callToAction={{
      target: '_blank',
      text: 'More testimonials...',
      href: '/contact',
      icon: 'tabler:chevron-right',
    }}
  />

  <Features2
    title="Our Locations"
    tagline="Reach out to us"
    columns={2}
    items={[
      { title: 'Da Nang City', description: 'Vietnam' },
      { title: 'Ho Chi Minh City', description: 'Vietnam' },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Get in Touch"
    tagline="Contact VNDEVS"
    columns={2}
    items={[
      {
        title: 'Chat with us',
        description: 'Quickly reach our team for inquiries about software projects, consulting, or games.',
        icon: 'tabler:messages',
      },
      {
        title: 'Call us',
        description: 'Direct line to our experts for urgent questions or consultations.',
        icon: 'tabler:headset',
      },
    ]}
  />
</Layout>
