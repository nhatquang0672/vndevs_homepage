---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'VNDEVS — Software, Mobile App & Game development | Simplicity, Best Practices & High Performance',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[{ variant: 'primary', text: 'Contact VNDEVS', href: '/contact', icon: 'tabler:arrow-up-right'}, { text: 'Learn more', href: '#features' }]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'VNDEVS project samples Hero Image' }}
  >
    <Fragment slot="title">
      Impress your customers with <span class="hidden xl:inline">high-quality</span>
      <span class="text-accent dark:text-white"> web apps, mobile apps & games</span> by VNDEVS
    </Fragment>
    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">VNDEVS</span> delivers exceptional quality in every project. We're a passionate, results-driven team specializing in web, mobile, and game solutions for discerning clients seeking reliability, unforgettable design, and high performance.
      </span>
      <span class="block mb-1 sm:hidden font-bold text-blue-600">VNDEVS: Where Quality Meets Innovation</span>
      Trusted by startups and companies who demand the best.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="Philosophy:" description="Simplicity, Best Practices and High Performance" />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    title="What you get with VNDEVS"
    subtitle="A proven team with a focus on quality, professionalism, and impressive delivery."
    items={[
      {
        title: 'Software Development & Consulting',
        description: 'VNDEVS delivers full-cycle software solutions—from idea to launch—including web apps, mobile apps, and games, crafted for scalability, maintainability, and security.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'Engineering Excellence & Reliability',
        description: 'Solutions built with engineering best practices, ensuring high performance, stability, and availability across all platforms.',
        icon: 'tabler:rocket',
      },
      {
        title: 'UI/UX Design & Analysis',
        description: 'We create intuitive and engaging interfaces with user-centric designs, backed by thorough analysis to maximize usability and satisfaction.',
        icon: 'tabler:list-check',
      },
      {
        title: 'Search Engine Optimization (SEO)',
        description: 'Get discovered through technical and on-page SEO integrated into all our web products, improving visibility and reach.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'Outsourcing & Ongoing Support',
        description: 'We provide flexible outsourcing options and reliable support, helping your projects succeed with expert guidance and continuous maintenance.',
        icon: 'tabler:settings',
      },
      {
        title: 'Collaboration & Innovation',
        description: 'We work in true partnership to deliver value, not just code, and love building the next big thing together with you.',
        icon: 'tabler:bulb',
      },
    ]}
  />
  <!-- Content Widget **************** -->
  <Content
    isReversed
    tagline="Why Choose VNDEVS"
    title="Modern, High-Performance Software Applications"
    items={[
      {
        title: 'Built with Modern Web Standards',
        description:
          'All VNDEVS projects follow best practices in architecture, code quality, and performance—ensuring long-lasting stability and easy maintenance.',
      },
      {
        title: 'Optimized for Speed',
        description:
          'We focus on fast loading, clean UI, and smooth interactions across all devices. Every project is optimized for Lighthouse performance and Core Web Vitals.',
      },
      {
        title: 'Reliable & Scalable',
        description:
          'Our solutions are designed for high availability and horizontal scalability—ready to grow alongside your business needs.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=2070&q=80',
      alt: 'Modern Web Development',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Engineering with excellence
      </h3>
      We deliver modern web apps designed for durability, performance, and user satisfaction.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

<!-- Content Widget **************** -->

<Content
  isAfterContent
  items={[
    {
      title: 'Flexible & Fully Customizable',
      description:
        'Our solutions are not locked to templates. Everything—from UI to backend logic—can be customized to match your brand and product vision.',
    },
    {
      title: 'Multiple Deployment Options',
      description:
        'Deploy on Docker, Kubernetes, cloud VPS, on-premise, or serverless platforms. VNDEVS supports diverse environments with ease.',
    },
    {
      title: 'Responsive Web Design',
      description:
        'Every VNDEVS project is built to work flawlessly on mobile, tablet, desktop, and ultra-wide screens with complete responsiveness.',
    },
    {
      title: 'Seamless Media Integration',
      description:
        'Images, videos, charts, notifications, and animations integrate smoothly to create a dynamic and engaging user experience.',
    },
  ]}
  image={{
    src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?auto=format&fit=crop&w=2194&q=80',
    alt: 'Responsive Design',
  }}
>
  <Fragment slot="content">
    Premium quality, adaptable for any business sector.
  </Fragment>

  <Fragment slot="bg">
    <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
  </Fragment>
</Content>

<!-- Content Widget **************** -->

<Content
  isReversed
  isAfterContent
  items={[
    {
      title: 'Engaging User Experience',
      description:
        'VNDEVS products are crafted to feel smooth, intuitive, and enjoyable—boosting user retention and interaction.',
    },
    {
      title: 'Continuous Enhancement',
      description:
        'We stay updated with modern tools and frameworks to ensure your project evolves with the industry’s latest trends and improvements.',
    },
    {
      title: 'Time & Cost Efficient',
      description:
        'Skip the complexity of building everything from zero. Our frameworks, templates, and dev practices help you launch faster with lower risk.',
    },
    {
      title: 'Reliable Development Partner',
      description:
        'Even without a large portfolio yet, VNDEVS follows enterprise-level coding standards and aims to become a trusted engineering provider.',
    },
  ]}
  image={{
    src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?auto=format&fit=crop&w=2070&q=80',
    alt: 'Modern Development',
  }}
>
  <Fragment slot="content">
    Built to support long-term growth and reliability.
  </Fragment>

  <Fragment slot="bg">
    <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
  </Fragment>
</Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="Build and launch your business solution with VNDEVS — fast, reliable, and professionally engineered."
    items={[
      {
        title: 'Step 1: <span class="font-medium">Share Your Vision</span>',
        description:
          "Tell us about your business goals, workflows, and challenges. Whether you need a web system, mobile app, or custom software, we analyze your requirements and propose the right solution.",
        icon: 'tabler:message-2',
      },
      {
        title: 'Step 2: <span class="font-medium">Design & Planning</span>',
        description:
          "We create clean and effective UI/UX designs while engineering the system architecture for long-term scalability, security, and performance.",
        icon: 'tabler:layout-grid',
      },
      {
        title: 'Step 3: <span class="font-medium">Development & Iteration</span>',
        description:
          "Our engineering team builds your product using modern technologies and solid engineering practices. We collaborate closely, deliver updates frequently, and refine the solution to match your business needs.",
        icon: 'tabler:code',
      },
      {
        title: 'Step 4: <span class="font-medium">Launch & Grow</span>',
        description:
          "When everything is tested and verified, we deploy your application with high availability and performance. VNDEVS continues to support scaling, integrations, and future improvements.",
        icon: 'tabler:rocket',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Project workflow image',
    }}
  />

  <BlogLatestPosts
    title="Find out more content in our Blog"
    information={`Our blog features updates, insights, and guides across both gaming and software products.
              Discover articles about new releases, product highlights, reviews, and helpful tips to support your buying decisions.
              Stay informed with the latest trends and explore solutions that can enhance your work, entertainment, and digital experience.`}
  />

  <!-- FAQs Widget ******************* -->

<FAQs
  title="Frequently Asked Questions"
  subtitle="Find clear answers to the most common questions about our platform, services, and how we help your business grow."
  tagline="FAQs"
  classes={{ container: 'max-w-6xl' }}
  items={[
    {
      title: 'Why choose our platform?',
      description:
        "We provide a reliable, scalable business solution designed to streamline your workflow, improve team productivity, and help you deliver better results for your customers.",
    },
    {
      title: 'What do I need to get started?',
      description:
        'All you need is an active account. Setup takes only a few minutes, and our onboarding process helps you configure everything your business needs from day one.',
    },
    {
      title: 'How do I install and set up the system?',
      description:
        "Simply follow the step-by-step installation guide in your dashboard. No technical background required — our tools are designed for teams of all sizes.",
    },
    {
      title: 'What kind of support do you offer?',
      description:
        'We offer the customer support, a dedicated knowledge base, and personalized onboarding for business clients with priority service needs.',
    },
    {
      title: 'Can I upgrade or scale later?',
      description:
        'Absolutely. Our platform is built to grow with your business. You can adjust your plan, add users, or integrate new features anytime.',
    },
    {
      title: 'Is my data secure?',
      description:
        'We use enterprise-grade security, encryption, and regular audits to ensure your data is always safe and compliant with global standards.',
    },
  ]}
/>

