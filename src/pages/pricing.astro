---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Pricing',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Pricing"
    title="Transparent Pricing — Custom Projects"
    subtitle="Get a quote for custom web, mobile, or game development from VNDEVS. Pricing aligned with your needs, clear value."
  />

  <!-- Pricing Widget ******************* -->

  <Prices
    title="Pricing — Tailored for You"
    subtitle="VNDEVS offers scoped packages and hourly options for every budget and ambition."
    prices={[
      {
        title: 'Startup',
        subtitle: 'For MVPs, design, or rapid launches',
        price: 390,
        period: 'per project',
        items: [
          { description: 'Consultation & Project Scope' },
          { description: 'Design, Build & Launch' },
          { description: 'QA & Support' },
        ],
        callToAction: { text: 'Get started', href: '/contact' },
      },
      {
        title: 'Business',
        subtitle: 'Full-featured custom apps or games',
        price: 2990,
        period: 'per project',
        items: [
          { description: 'Includes everything in Startup' },
          { description: 'Full-stack development' },
          { description: 'Advanced integrations' },
          { description: 'Ongoing maintenance' },
        ],
        hasRibbon: true,
        ribbonTitle: 'Most Popular',
        callToAction: { text: 'Contact Us', href: '/contact' },
      },
      {
        title: 'Enterprise',
        subtitle: 'Long-term partnership, all-in support',
        price: 9900,
        period: 'per project / contract',
        items: [
          { description: 'Custom solutions, consulting, and dedicated support' },
          { description: 'Large scale or complex deployments' },
          { description: 'Best-in-class security & compliance' },
        ],
        callToAction: { text: 'Talk to Sales', href: '/contact' },
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Price-related features"
    subtitle="Discover the advantages of choosing our plans"
    columns={2}
    items={[
      {
        title: 'Tiered Pricing Plans',
        description: 'Choose from a range of pricing plans designed to accommodate different budgets and requirements.',
        icon: 'tabler:stairs',
      },
      {
        title: 'Transparent Pricing',
        description: 'Clearly displayed pricing details for each plan, with no hidden costs or unexpected charges.',
        icon: 'tabler:flip-vertical',
      },
      {
        title: 'Secure Payment Methods',
        description: 'Secure payment gateways to protect your financial information during transactions.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Instant Access',
        description: `Immediate access to your chosen plan's features and templates upon subscription.`,
        icon: 'tabler:accessible',
      },
      {
        title: 'Upgrade Value',
        description: 'Upgrade to higher-tier plans to unlock more features and benefits for an enhanced experience.',
        icon: 'tabler:chevrons-up',
      },
      {
        title: '24H support',
        description: 'Questions answered via live chat, email or phone, every calendar day.',
        icon: 'tabler:headset',
      },
    ]}
    classes={{ container: 'max-w-5xl' }}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="Your journey with VNDEVS"
    tagline="From idea to solution, simplified"
    isReversed={true}
    items={[
      {
        title: 'Contact Us',
        icon: 'tabler:number-1',
      },
      {
        title: 'Discuss Your Requirements',
        icon: 'tabler:number-2',
      },
      {
        title: 'Receive a Proposal & Quote',
        icon: 'tabler:number-3',
      },
      {
        title: 'Approve Plan & Timeline',
        icon: 'tabler:number-4',
      },
      {
        title: 'Project Development',
        icon: 'tabler:number-5',
      },
      {
        title: 'Review & Feedback',
        icon: 'tabler:number-6',
      },
      {
        title: 'Delivery & Support',
        icon: 'tabler:number-7',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1536816579748-4ecb3f03d72a?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'VNDEVS workflow',
    }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Pricing FAQs"
    subtitle="Choosing the right plan is important, and we're here to answer your questions. If you have queries about our pricing options, you're in the right place."
    columns={1}
    items={[
      {
        title: 'Do the plans come with customer support?',
        description:
          'Absolutely, all plans include access to our dedicated customer support to assist you with any queries or concerns.',
      },
      {
        title: 'Can I get a demo or trial before committing?',
        description:
          'For software development, we can provide prototypes or demo versions to showcase functionality. For hosted games, you can preview gameplay before purchase or hosting.',
      },
      {
        title: 'Can I adjust the scope or features during the project?',
        description:
          'Absolutely! We work closely with you to adapt the project plan, features, or timeline based on your evolving requirements.',
      },
      {
        title: 'What payment methods do you accept?',
        description:
          'We accept major credit cards, bank transfers, and secure online payments. Payment terms are discussed upfront in the project proposal.',
      },
      {
        title: 'Are there any hidden costs?',
        description:
          'No hidden fees. All costs, including development, hosting setup, and optional support, are clearly outlined in the project proposal.',
      },
    ]}
  />
  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="Ready to boost your projects?"
    subtitle="Join our community of satisfied customers who have transformed their work with our services."
    actions={[
      {
        variant: 'primary',
        text: 'Get started now',
        href: '/contact',
      },
    ]}
  />
</Layout>
